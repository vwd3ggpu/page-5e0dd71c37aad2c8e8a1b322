          "body": "<style>\n  :root{--ink:#111214;--ink-2:#3c3f44;--grey:#6d7176;--line:#c9ccd0;--paper:#f7f7f5;--white:#ffffff;--accent:#d7263d}\n  *{box-sizing:border-box}\n  html,body{margin:0;padding:0}\n  body{background:var(--paper);color:var(--ink);font-family:\"Helvetica Neue\",Helvetica,Arial,\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",sans-serif;font-size:16px;line-height:1.7;-webkit-font-smoothing:antialiased}\n  a{color:var(--ink);text-decoration:none;border-bottom:1px solid var(--line)}\n  a:hover{color:var(--accent);border-bottom-color:var(--accent)}\n  .wrap{max-width:1080px;margin:0 auto;padding:0 24px}\n\n  /* 首屏：超大字号品牌名铺满 */\n  .hero{background:var(--white);border-bottom:1px solid var(--line);padding:56px 0 40px}\n  .hero-eyebrow{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--grey);border-bottom:1px solid var(--line);padding-bottom:14px;margin-bottom:18px}\n  .brandmark{font-size:clamp(84px,21vw,232px);line-height:.86;letter-spacing:-.05em;font-weight:800;margin:0;color:var(--ink)}\n  .brandmark .dot{color:var(--accent)}\n  .hero-lead{display:grid;grid-template-columns:1.35fr 1fr;gap:36px;margin-top:26px;padding-top:24px;border-top:1px solid var(--ink)}\n  .hero-lead p{margin:0 0 14px}\n  .hero-lead .kicker{font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);font-weight:700;margin-bottom:10px}\n  .hero-facts{font-size:14px;color:var(--ink-2)}\n  .hero-facts dl{margin:0;display:grid;grid-template-columns:auto 1fr;gap:8px 16px}\n  .hero-facts dt{color:var(--grey);white-space:nowrap}\n  .hero-facts dd{margin:0}\n\n  /* 区块内跳转链接（无主导航） */\n  .index-jump{background:var(--ink);color:var(--paper);padding:14px 0}\n  .index-jump .wrap{display:flex;gap:22px;flex-wrap:wrap;align-items:baseline;font-size:13px;letter-spacing:.06em}\n  .index-jump .label{color:#9a9ea3;letter-spacing:.18em;text-transform:uppercase;font-size:11px}\n  .index-jump a{color:var(--paper);border-bottom:1px dotted #6d7176}\n  .index-jump a:hover{color:#fff;border-bottom-color:var(--accent)}\n\n  section{padding:64px 0}\n  section + section{border-top:1px solid var(--line)}\n  h2{font-size:clamp(24px,3.4vw,34px);line-height:1.25;margin:0 0 8px;letter-spacing:-.02em}\n  .sec-num{display:inline-block;font-size:12px;letter-spacing:.2em;color:var(--accent);font-weight:700;margin-bottom:12px}\n  .sec-note{color:var(--grey);font-size:14px;max-width:56ch;margin:0 0 34px}\n\n  /* 票据风格卡片 */\n  .ticket{background:var(--white);border:1px dashed var(--line);padding:24px;position:relative}\n  .ticket + .ticket{margin-top:18px}\n  .ticket::before{content:\"\";position:absolute;left:-7px;top:18px;width:12px;height:12px;border:1px dashed var(--line);border-radius:50%;background:var(--paper)}\n  .ticket-tag{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--grey)}\n\n  /* 步骤 */\n  .steps{display:grid;gap:18px;grid-template-columns:repeat(2,1fr)}\n  .step-ticket{display:flex;gap:18px;align-items:flex-start}\n  .step-no{font-size:30px;font-weight:800;line-height:1;color:var(--ink);min-width:46px;letter-spacing:-.03em}\n  .step-ticket h3{margin:0 0 6px;font-size:17px}\n  .step-ticket p{margin:0;font-size:14px;color:var(--ink-2)}\n\n  /* 套餐：两栏对照 + 推荐标记 */\n  .plans{display:grid;grid-template-columns:1fr 1fr;gap:22px;align-items:start}\n  .plan-card{background:var(--white);border:1px dashed var(--line);padding:26px 24px 28px;display:flex;flex-direction:column}\n  .plan-card.featured{border:1px solid var(--ink);box-shadow:6px 6px 0 var(--ink)}\n  .plan-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}\n  .plan-name{font-size:20px;margin:0;letter-spacing:-.01em}\n  .badge{font-size:11px;letter-spacing:.14em;background:var(--accent);color:var(--white);padding:3px 8px;white-space:nowrap;font-weight:700}\n  .plan-price{font-size:34px;font-weight:800;letter-spacing:-.03em;margin:16px 0 2px}\n  .plan-price small{font-size:14px;font-weight:400;color:var(--grey);letter-spacing:0}\n  .plan-annual{font-size:13px;color:var(--grey);margin:0 0 18px}\n  .plan-list{list-style:none;margin:0;padding:16px 0 0;border-top:1px dashed var(--line);flex:1}\n  .plan-list li{font-size:14px;color:var(--ink-2);padding-left:18px;position:relative;margin-bottom:9px}\n  .plan-list li::before{content:\"\";position:absolute;left:0;top:.62em;width:7px;height:2px;background:var(--accent)}\n  .plan-note{font-size:12px;color:var(--grey);margin:16px 0 0}\n\n  .split{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:22px}\n\n  /* 客户端 */\n  .client-box{background:var(--white);border:1px dashed var(--line);padding:24px}\n  .client-box h3{margin:0 0 10px;font-size:17px}\n  .client-box ul{margin:0;padding-left:18px;font-size:14px;color:var(--ink-2)}\n  .client-box li{margin-bottom:7px}\n\n  /* 对话气泡 FAQ */\n  .qa{display:grid;gap:18px;max-width:840px}\n  .qa-row{display:flex;gap:14px;align-items:flex-start}\n  .qa-row.ask{justify-content:flex-end}\n  .bubble{padding:14px 18px;font-size:14.5px;max-width:76%;border:1px dashed var(--line);background:var(--white)}\n  .qa-row.ask .bubble{background:var(--ink);color:var(--paper);border:1px solid var(--ink)}\n  .bubble h3{margin:0 0 6px;font-size:14.5px;letter-spacing:.01em}\n  .qa-row.ask .bubble h3{color:var(--white);font-weight:600}\n  .bubble p{margin:0;color:var(--ink-2)}\n  .qa-row.ask .bubble p{color:#d9dbdd}\n  .av{flex:0 0 30px;width:30px;height:30px;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;font-size:12px;color:var(--grey);background:var(--white)}\n  .qa-row.ask .av{border-color:var(--ink);color:var(--ink)}\n\n  /* 结语 */\n  .closing{background:var(--ink);color:var(--paper);padding:56px 0}\n  .closing h2{color:var(--white)}\n  .closing p{color:#c3c6ca;max-width:60ch;font-size:15px}\n  .closing .links{display:flex;gap:26px;flex-wrap:wrap;margin-top:24px;font-size:14px}\n  .closing .links a{color:var(--white);border-bottom:1px solid #6d7176}\n  .closing .links a:hover{color:var(--accent);border-bottom-color:var(--accent)}\n\n  footer{padding:26px 0;font-size:12px;color:var(--grey)}\n  footer .wrap{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}\n\n  @media (max-width:820px){\n    .hero-lead{grid-template-columns:1fr;gap:24px}\n    .steps{grid-template-columns:1fr}\n    .plans{grid-template-columns:1fr}\n    .plan-card.featured{box-shadow:4px 4px 0 var(--ink)}\n    .split{grid-template-columns:1fr}\n    .bubble{max-width:100%}\n  }\n</style><main>\n\n  <header class=\"hero\">\n    <div class=\"wrap\">\n      <div class=\"hero-eyebrow\">\n        <span>飞网 · 使用说明书</span>\n        <span>清单式务实口吻 · 无导航，按区块跳转</span>\n      </div>\n      <h1 class=\"brandmark\">飞网<span class=\"dot\">.</span></h1>\n      <div class=\"hero-lead\">\n        <div>\n          <div class=\"kicker\">先把话说清楚</div>\n          <p>这是一份把订阅讲成清单的页面。你要做的三件事只有：看清流量和设备数、挑一个适合自己的档位、按步骤把客户端设好。</p>\n          <p>没有隐藏动作，也不靠形容词撑场面。下面每个区块都能直接跳到你要找的那一节。</p>\n        </div>\n        <div class=\"hero-facts\">\n          <dl>\n            <dt>页面性质</dt><dd>品牌订阅说明与设置指南</dd>\n            <dt>套餐档位</dt><dd>三档，按月或按年</dd>\n            <dt>正文长度</dt><dd>看完约五分钟</dd>\n            <dt>下一步</dt><dd>看套餐对照，再确定周期</dd>\n          </dl>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  <div class=\"index-jump\">\n    <div class=\"wrap\">\n      <span class=\"label\">跳到</span>\n      <a href=\"#howto\">设置步骤</a>\n      <a href=\"#plans\">套餐对照</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n      <a href=\"#notes\">再说几句</a>\n    </div>\n  </div>\n\n  <section id=\"howto\">\n    <div class=\"wrap\">\n      <span class=\"sec-num\">01 / 设置步骤</span>\n      <h2>四步走完，别跳步</h2>\n      <p class=\"sec-note\">顺序是有理由的：先确认套餐信息，再定周期，然后装客户端，最后检查设备数。跳步的人大多会在设备上限那一栏卡住。</p>\n\n      <div class=\"steps\">\n        <div class=\"ticket step-ticket\">\n          <div class=\"step-no\">1</div>\n          <div>\n            <h3>核对流量与设备数</h3>\n            <p>把每月流量和同时在线设备数写在一张纸上，对照自己的日常用法。两个数字里先卡住你的那一个，才是决定档位的那一个。</p>\n          </div>\n        </div>\n        <div class=\"ticket step-ticket\">\n          <div class=\"step-no\">2</div>\n          <div>\n            <h3>决定按月还是按年</h3>\n            <p>能确定会用满一年，就选年付；还在试水，就按月。年付的价值在于把预算固定下来，而不是别的。</p>\n          </div>\n        </div>\n        <div class=\"ticket step-ticket\">\n          <div class=\"step-no\">3</div>\n          <div>\n            <h3>在客户端里完成配置</h3>\n            <p>按平台选择客户端，把给你的订阅信息填进去，保存后确认连接状态。具体入口见下方客户端区块。</p>\n          </div>\n        </div>\n        <div class=\"ticket step-ticket\">\n          <div class=\"step-no\">4</div>\n          <div>\n            <h3>清点同时在线的设备</h3>\n            <p>把手机、平板、电脑列出来，数一数。超过上限并不神秘，只是同时在线名额被占满了，先登出闲置设备即可。</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <span class=\"sec-num\">02 / 套餐对照</span>\n      <h2>三档价目，两栏放在一起看</h2>\n      <p class=\"sec-note\">下面把三档并列摆放，重点比较流量与设备数。标有推荐标记的是旗舰版，因为它同时覆盖了中等流量和多设备这两种常见需求。</p>\n\n      <div class=\"plans\">\n        <div class=\"plan-card\">\n          <div class=\"plan-head\">\n            <h3 class=\"plan-name\">基础版</h3>\n          </div>\n          <div class=\"plan-price\">¥15 <small>/ 月</small></div>\n          <p class=\"plan-annual\">按年付仅需 ¥150 / 年</p>\n          <ul class=\"plan-list\">\n            <li>每月 100GB 流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>基础流媒体解锁</li>\n            <li>普通线路节点池</li>\n          </ul>\n          <p class=\"plan-note\">适合设备少、用量集中在固定几台机器的人。</p>\n        </div>\n\n        <div class=\"plan-card featured\">\n          <div class=\"plan-head\">\n            <h3 class=\"plan-name\">旗舰版</h3>\n            <span class=\"badge\">推荐</span>\n          </div>\n          <div class=\"plan-price\">¥35 <small>/ 月</small></div>\n          <p class=\"plan-annual\">按年付仅需 ¥350 / 年</p>\n          <ul class=\"plan-list\">\n            <li>每月 300GB 流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7x24 优先工单支持</li>\n          </ul>\n          <p class=\"plan-note\">适合手机加电脑多设备切换、并且在意响应的人。</p>\n        </div>\n\n        <div class=\"plan-card\">\n          <div class=\"plan-head\">\n            <h3 class=\"plan-name\">团队版</h3>\n          </div>\n          <div class=\"plan-price\">¥85 <small>/ 月</small></div>\n          <p class=\"plan-annual\">按年付仅需 ¥850 / 年</p>\n          <ul class=\"plan-list\">\n            <li>每月 1000GB 流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n          <p class=\"plan-note\">适合需要统一管理多台设备、并要有人对接的场景。</p>\n        </div>\n\n        <div class=\"plan-card\">\n          <div class=\"plan-head\">\n            <h3 class=\"plan-name\">共同条款</h3>\n          </div>\n          <div class=\"plan-price\">同一套规则</div>\n          <p class=\"plan-annual\">三档都遵循以下这几条</p>\n          <ul class=\"plan-list\">\n            <li>流量按自然月计算，不跨月结转</li>\n            <li>同时在线设备数以套餐标注为准</li>\n            <li>年付与月付的内容一致，只是周期不同</li>\n            <li>升级档位时，从下一周期起按新档位计算</li>\n          </ul>\n          <p class=\"plan-note\">具体以你实际看到的订阅信息为准。</p>\n        </div>\n      </div>\n\n      <div class=\"split\">\n        <div class=\"client-box\">\n          <h3>怎么选：先看设备数</h3>\n          <ul>\n            <li>两台以内、用量不大：基础版</li>\n            <li>三到五台、经常切设备：旗舰版</li>\n            <li>多人或多终端统一管理：团队版</li>\n            <li>不确定：先按月，用满一个周期再决定</li>\n          </ul>\n        </div>\n        <div class=\"client-box\">\n          <h3>怎么算：年付只是压缩周期</h3>\n          <ul>\n            <li>年付金额等于十个月月费，省下两月</li>\n            <li>不做超出套餐内容的承诺</li>\n            <li>预算固定下来，就不用每月提醒自己</li>\n            <li>中途用不完的时间，不会折成流量</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <span class=\"sec-num\">03 / 客户端</span>\n      <h2>按你的设备，逐个装</h2>\n      <p class=\"sec-note\">客户端不是重点，配置对才是。下面只讲每类设备上该做什么，不提供未经确认的下载地址；具体入口请以你收到的订阅信息为准。</p>\n\n      <div class=\"split\">\n        <div class=\"client-box\">\n          <h3>手机与平板</h3>\n          <ul>\n            <li>先在系统设置里确认网络权限已允许</li>\n            <li>把订阅信息填入客户端后保存</li>\n            <li>连接状态显示成功再开始使用</li>\n            <li>占用的名额算一个，闲置时建议登出</li>\n          </ul>\n        </div>\n        <div class=\"client-box\">\n          <h3>电脑端</h3>\n          <ul>\n            <li>优先用桌面客户端，比浏览器设置更稳定</li>\n            <li>填完订阅后重启一次客户端</li>\n            <li>若同时开多个终端，注意设备数上限</li>\n            <li>遇到连不上，先断开再重连一次</li>\n          </ul>\n        </div>\n        <div class=\"client-box\">\n          <h3>配置前要准备的三样</h3>\n          <ul>\n            <li>你选定的档位与周期</li>\n            <li>客户端的订阅信息</li>\n            <li>一份设备清单，用来核对名额</li>\n          </ul>\n        </div>\n        <div class=\"client-box\">\n          <h3>配置后要确认的三样</h3>\n          <ul>\n            <li>连接状态是否为成功</li>\n            <li>同时在线的设备有没有超出上限</li>\n            <li>流量是否按自然月正常统计</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <span class=\"sec-num\">04 / 常见问题</span>\n      <h2>问与答，一问一条</h2>\n      <p class=\"sec-note\">下面每个回答只说确定的事。涉及具体节点、速度或退款的内容，不在可确认范围内，所以不做承诺。</p>\n\n      <div class=\"qa\">\n        <div class=\"qa-row\">\n          <div class=\"av\">问</div>\n          <div class=\"bubble\">\n            <h3>三档套餐最该比哪一项？</h3>\n            <p>比设备数，其次比流量。设备数决定你日常能不能顺手切换，流量只影响你每月用多少。</p>\n          </div>\n        </div>\n        <div class=\"qa-row ask\">\n          <div class=\"bubble\">\n            <h3>设备数是怎么算的？</h3>\n            <p>按同时在线的设备计算。基础版 3 台，旗舰版 5 台，团队版 20 台。先登出闲置设备，就能腾出名额。</p>\n          </div>\n          <div class=\"av\">答</div>\n        </div>\n\n        <div class=\"qa-row\">\n          <div class=\"av\">问</div>\n          <div class=\"bubble\">\n            <h3>年付划算吗？</h3>\n            <p>年付金额相当于十个月月费，省下两个月。前提是你确定会用满一年。</p>\n          </div>\n        </div>\n        <div class=\"qa-row ask\">\n          <div class=\"bubble\">\n            <h3>中途想换档位怎么办？</h3>\n            <p>从下一个计费周期起按新档位计算，当期仍按原档位执行。</p>\n          </div>\n          <div class=\"av\">答</div>\n        </div>\n\n        <div class=\"qa-row\">\n          <div class=\"av\">问</div>\n          <div class=\"bubble\">\n            <h3>流量用不完能留到下个月吗？</h3>\n            <p>不能。流量按自然月计算，不跨月结转，用不完的部分月底清零。</p>\n          </div>\n        </div>\n        <div class=\"qa-row ask\">\n          <div class=\"bubble\">\n            <h3>客户端装好了却连不上，先查什么？</h3>\n            <p>先查三件事：订阅信息是否完整填好、系统是否允许了网络权限、同时在线设备是否已满。这三项排除之后再考虑其他原因。</p>\n          </div>\n          <div class=\"av\">答</div>\n        </div>\n\n        <div class=\"qa-row\">\n          <div class=\"av\">问</div>\n          <div class=\"bubble\">\n            <h3>团队版和旗舰版的差别在哪里？</h3>\n            <p>团队版在设备数与流量之外，多了专属高带宽节点、企业定制路由和专属客户经理；旗舰版则包含流媒体解锁与游戏加速优化。按需求对号入座即可。</p>\n          </div>\n        </div>\n        <div class=\"qa-row ask\">\n          <div class=\"bubble\">\n            <h3>有客服能问具体节点情况吗？</h3>\n            <p>旗舰版标注了 7x24 优先工单支持，团队版有专属客户经理。可确认的只有这些支持方式本身，具体节点的实时状态不在页面的承诺范围内。</p>\n          </div>\n          <div class=\"av\">答</div>\n        </div>\n\n        <div class=\"qa-row\">\n          <div class=\"av\">问</div>\n          <div class=\"bubble\">\n            <h3>第一次订阅，选哪个比较好？</h3>\n            <p>如果你平时在两三台设备之间切换，直接用旗舰版最省心；只有一台设备、用量很小，基础版就够了。先按月试一个周期，再决定是否转年付。</p>\n          </div>\n        </div>\n        <div class=\"qa-row ask\">\n          <div class=\"bubble\">\n            <h3>页面上的价格就是最终价格吗？</h3>\n            <p>本页列的是 ¥15、¥35、¥85 三档月费及对应的年付金额。实际计价与支付方式请以你订阅时看到的页面为准。</p>\n          </div>\n          <div class=\"av\">答</div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"notes\">\n    <div class=\"closing\">\n      <div class=\"wrap\">\n        <span class=\"sec-num\">05 / 再说几句</span>\n        <h2>把选择简化成一张清单</h2>\n        <p>选套餐这件事，本质上是三个问题：几台设备、每月大概用多少、准备用多久。把答案写下来，档位和周期基本就定了。飞网这份页面能帮你的，就是把这些信息摆在同一屏里，让你不必来回翻。</p>\n        <p>如果看完仍有不确定的地方，回到设置步骤那一节，从第一步重新核对一遍。多数疑问都出在设备数或周期上。</p>\n        <div class=\"links\">\n          <a href=\"#howto\">回到设置步骤</a>\n          <a href=\"#plans\">再看套餐对照</a>\n          <a href=\"#faq\">重读常见问题</a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <span>飞网 · 订阅说明与使用清单</span>\n    <span>文中价格与权益以页面所列内容为准</span>\n  </div>\n</footer>",
